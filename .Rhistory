checa_km_percorrrido_entrevistador <- function(dados){
dados %>%
dplyr::select(
sbj_num,date, srvyr,
latitude,longitude,
v_start, v_end, subj_data
) %>%
dplyr::arrange(srvyr, v_start) %>%
dplyr::mutate(
.by = srvyr,
prev_lat = lag(latitude),
prev_long = lag(longitude),
distance = geosphere::distHaversine(
cbind(prev_long, prev_lat),
cbind(longitude, latitude))
) %>%
dplyr::mutate(
data = as.Date(date, format = "%Y-%m-%d")
) %>%
dplyr::summarise(
.by = c(srvyr, data),
km_percorrido = sum(distance, na.rm = TRUE)/1000,
subj_data = subj_data
) %>%
dplyr::arrange(dplyr::desc(km_percorrido))
}
